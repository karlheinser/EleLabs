# ===== ضروری =====
TELEGRAM_BOT_TOKEN=123456:ABC...
ELEVENLABS_API_KEY=sk_...   # از پنل مدیریت ← 🔑 کلید API هم قابل تغییر است

# ===== مدیریت و دسترسی =====
ADMIN_IDS=123456789                 # آیدی عددی خودت (از @userinfobot)
ALLOWED_USER_IDS=                   # لیست سفید ثابت (اختیاری؛ از پنل مدیریت هم می‌شه اضافه کرد)
REQUIRED_CHANNELS=                  # مثل @mychannel  (ربات باید ادمین کانال باشد)
ADMIN_ONLY_FEATURES=                # مثل clone,design,dub,music,library

# ===== اعتبار و فروش =====
DAILY_FREE_CREDITS=2000             # مقدار اولیه؛ از پنل مدیریت قابل تغییر است
STAR_PACKAGES=5000:50,20000:150,100000:500   # اعتبار:ستاره
COST_TTS=1                          # به ازای هر کاراکتر (همه از پنل مدیریت قابل تغییرند)
COST_STT=300
COST_CHANGER=500
COST_ISOLATE=500
COST_DUB=3000
COST_CLONE=1000
COST_DESIGN=500
COST_SFX=200
COST_MUSIC=2000                     # به ازای هر دقیقه

# ===== مدل‌ها (اختیاری) =====
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_v3
DIALOGUE_MODEL_ID=eleven_v3
STT_MODEL_ID=scribe_v2
STS_MODEL_ID=eleven_multilingual_sts_v2
VOICE_DESIGN_MODEL_ID=eleven_ttv_v3
MUSIC_MODEL_ID=music_v1
SFX_MODEL_ID=eleven_text_to_sound_v2

# ===== زیرساخت =====
DB_PATH=/data/bot.db                # مسیر Volume در Railway
MAX_CONCURRENT_JOBS=3
STORAGE_CHAT_ID=                    # آیدی کانال خصوصی برای حالت Inline (مثل -100123...)
USE_WEBHOOK=auto                    # auto: اگر دامنهٔ Railway باشد webhook، وگرنه polling
WEBHOOK_SECRET=
